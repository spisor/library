# spisor_definition_operations(<output .c> DEFINITIONS <directory> INCLUDE_ROOT <directory> PREFIX <prefix>
#     LAYOUTS <layouts target> SHAPES <include directory>...) generates, at build time, the table of every operation of
# every definition a header in DEFINITIONS declares, with each parameter's struct, its first shape and, for an answer,
# the fields its layout counts arrays in. testing/definition_calls.h declares the table and the checks that read it.
#
# The operations come from the headers, so one added later is in the table without anything else changing, and an
# operation whose signature this reads no rule for fails the build rather than going unchecked. A parameter's first
# shape is the field its struct's documentation says it ends at, `First shape ends at <field>`, in a header under
# SHAPES; the fields come from what the LAYOUTS program prints, which the layouts check holds to every field the
# headers declare. Run as a script it is that generator, with each argument as a -D of the same name and -DOUTPUT.
#
# spisor_add_definition_call_test(<name> SOURCE <c file> LIBRARY <shared library target> OPERATIONS <output .c>) adds
# a test built from SOURCE and the generated table that loads LIBRARY as a consumer would.

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    cmake_minimum_required(VERSION 3.19)
endif()
include_guard(GLOBAL)

set(SPISOR_DEFINITION_CALLS_SCRIPT ${CMAKE_CURRENT_LIST_FILE})

function(spisor_definition_operations output)
    cmake_parse_arguments(PARSE_ARGV 1 GENERATE "" "DEFINITIONS;INCLUDE_ROOT;PREFIX;LAYOUTS" "SHAPES")
    set(headers "")
    foreach(directory IN LISTS GENERATE_SHAPES)
        file(GLOB_RECURSE found CONFIGURE_DEPENDS "${directory}/*.h")
        list(APPEND headers ${found})
    endforeach()
    string(REPLACE ";" "," shapes "${GENERATE_SHAPES}")
    add_custom_command(OUTPUT ${output}
        COMMAND ${CMAKE_COMMAND} -DLAYOUTS=$<TARGET_FILE:${GENERATE_LAYOUTS}> -DDEFINITIONS=${GENERATE_DEFINITIONS}
            -DINCLUDE_ROOT=${GENERATE_INCLUDE_ROOT} -DPREFIX=${GENERATE_PREFIX} -DSHAPES=${shapes} -DOUTPUT=${output}
            -P ${SPISOR_DEFINITION_CALLS_SCRIPT}
        DEPENDS ${GENERATE_LAYOUTS} ${SPISOR_DEFINITION_CALLS_SCRIPT} ${headers}
        COMMENT "Generating the table of every definition operation"
        VERBATIM)
endfunction()

function(spisor_add_definition_call_test name)
    cmake_parse_arguments(PARSE_ARGV 1 CALL_TEST "" "SOURCE;LIBRARY;OPERATIONS" "")
    add_executable(${name} ${CALL_TEST_SOURCE} ${CALL_TEST_OPERATIONS})
    target_compile_definitions(${name} PRIVATE SPISOR_DEFINITION_LIBRARY_PATH="$<TARGET_FILE:${CALL_TEST_LIBRARY}>")
    target_link_libraries(${name} PRIVATE spisor_definition_calls)
    add_dependencies(${name} ${CALL_TEST_LIBRARY})
    spisor_strict_warnings(${name})
    add_test(NAME ${name} COMMAND ${name})
endfunction()

# Text whose `;`, `[` and `]` are spelled out, so a list holds it whole.
function(spisor_listable_text text out)
    string(REPLACE ";" "@semicolon@" text "${text}")
    string(REPLACE "[" "@open_bracket@" text "${text}")
    string(REPLACE "]" "@close_bracket@" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The documented first shape of every struct a header defines, as shape_of_<struct> in the caller's scope.
function(spisor_read_first_shapes header)
    file(READ "${header}" content)
    spisor_listable_text("${content}" content)
    string(REPLACE "*/" ";" pieces "${content}")
    list(LENGTH pieces piece_count)
    math(EXPR last "${piece_count} - 1")
    foreach(index RANGE 1 ${last})
        list(GET pieces ${index} code)
        if(NOT code MATCHES "^[ \t\r\n]*(typedef[ \t\r\n]+)?struct[ \t\r\n]+([A-Za-z0-9_]+)[ \t\r\n]*{")
            continue()
        endif()
        set(struct "${CMAKE_MATCH_2}")
        math(EXPR previous "${index} - 1")
        list(GET pieces ${previous} before)
        string(FIND "${before}" "/**" open REVERSE)
        if(open EQUAL -1)
            continue()
        endif()
        string(SUBSTRING "${before}" ${open} -1 comment)
        string(REGEX REPLACE "[ \t\r\n*]+" " " comment "${comment}")
        if(comment MATCHES "First shape ends at `([A-Za-z0-9_.]+)`")
            set(shape_of_${struct} "${CMAKE_MATCH_1}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# A header's code on one line: comments gone, every run of whitespace one space, `;` spelled ` @ `.
function(spisor_header_code header out)
    file(READ "${header}" content)
    set(code "")
    set(rest "${content}")
    while(TRUE)
        string(FIND "${rest}" "/*" open)
        if(open EQUAL -1)
            string(APPEND code "${rest}")
            break()
        endif()
        string(SUBSTRING "${rest}" 0 ${open} before)
        string(APPEND code "${before} ")
        math(EXPR after "${open} + 2")
        string(SUBSTRING "${rest}" ${after} -1 rest)
        string(FIND "${rest}" "*/" close)
        if(close EQUAL -1)
            message(FATAL_ERROR "${header} has a comment that never ends")
        endif()
        math(EXPR after "${close} + 2")
        string(SUBSTRING "${rest}" ${after} -1 rest)
    endwhile()
    string(REGEX REPLACE "//[^\n]*" "" code "${code}")
    spisor_listable_text("${code}" code)
    string(REPLACE "@semicolon@" " @ " code "${code}")
    string(REGEX REPLACE "[ \t\r\n]+" " " code "${code}")
    string(REPLACE "( " "(" code "${code}")
    string(REPLACE " )" ")" code "${code}")
    set(${out} "${code}" PARENT_SCOPE)
endfunction()

# The fields the layouts program printed for every struct, as layout_fields_of_<struct> in the caller's scope.
function(spisor_read_layout_fields layouts)
    execute_process(COMMAND ${layouts} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0")
        message(FATAL_ERROR "${layouts} exited ${code}\n${errors}")
    endif()
    string(REPLACE "\r" "" output "${output}")
    string(REPLACE "\n" ";" lines "${output}")
    set(structs "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^ ]+) ([^ ]+) [0-9]+ [0-9]+$")
            list(APPEND structs "${CMAKE_MATCH_1}")
            list(APPEND layout_fields_of_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        endif()
    endforeach()
    if(NOT structs)
        message(FATAL_ERROR "${layouts} printed no field")
    endif()
    list(REMOVE_DUPLICATES structs)
    foreach(struct IN LISTS structs)
        set(layout_fields_of_${struct} "${layout_fields_of_${struct}}" PARENT_SCOPE)
    endforeach()
endfunction()

# The C lines describing one parameter of `type`, an answer when `is_answer`, appended to the caller's `declarations`;
# its initializer is set as `parameter` in the caller's scope.
function(spisor_parameter_entry type is_answer)
    if(NOT DEFINED shape_of_${type})
        message(FATAL_ERROR "${type} documents no first shape (`First shape ends at <field>`) under ${SHAPES}")
    endif()
    set(through "${shape_of_${type}}")
    if(NOT through IN_LIST layout_fields_of_${type})
        message(FATAL_ERROR "${type}'s first shape ends at ${through}, which its layout does not print")
    endif()
    set(shape "offsetof(${type}, ${through}) + sizeof(((${type} *)0)->${through})")
    set(counts "")
    if(is_answer)
        foreach(field IN LISTS layout_fields_of_${type})
            if(field MATCHES "^([a-z0-9_]+_)?count$")
                list(APPEND counts "${field}")
            endif()
        endforeach()
    endif()
    list(LENGTH counts count_total)
    if(count_total EQUAL 0)
        set(parameter "{\"${type}\", sizeof(${type}), ${shape}, ${is_answer}, NULL, NULL, 0}")
    else()
        get_property(declared GLOBAL PROPERTY spisor_declared_counts_of_${type})
        if(NOT declared)
            set(offsets "")
            set(names "")
            foreach(field IN LISTS counts)
                string(APPEND declarations "_Static_assert(sizeof(((${type} *)0)->${field}) == sizeof(size_t), "
                    "\"${type}'s ${field} is a size_t\");\n")
                list(APPEND offsets "offsetof(${type}, ${field})")
                list(APPEND names "\"${field}\"")
            endforeach()
            string(JOIN ", " offsets ${offsets})
            string(JOIN ", " names ${names})
            string(APPEND declarations "static const size_t count_offsets_of_${type}[] = {${offsets}};\n"
                "static const char *const count_names_of_${type}[] = {${names}};\n")
            set_property(GLOBAL PROPERTY spisor_declared_counts_of_${type} TRUE)
        endif()
        string(CONCAT parameter "{\"${type}\", sizeof(${type}), ${shape}, ${is_answer}, count_offsets_of_${type}, "
            "count_names_of_${type}, ${count_total}}")
    endif()
    set(parameter "${parameter}" PARENT_SCOPE)
    set(declarations "${declarations}" PARENT_SCOPE)
endfunction()

# Appends to the caller's `declarations` and `operations` the C for every operation of the definition `definition`,
# whose members `members` lists with each member's statement as one element.
function(spisor_definition_entries definition symbol members)
    set(has_release_refusal FALSE)
    foreach(member IN LISTS members)
        string(STRIP "${member}" member)
        if(NOT member MATCHES "\\(\\*([a-z0-9_]+)\\)")
            continue()
        endif()
        set(operation "${CMAKE_MATCH_1}")
        if(member MATCHES "^void \\(\\*${operation}\\)\\(void \\*context, (const )?[A-Za-z0-9_]+ \\*[a-z0-9_]+\\)$")
            if(operation STREQUAL "release_refusal")
                set(has_release_refusal TRUE)
            endif()
            continue()
        endif()
        set(status_operation "^spisor_status \\(\\*${operation}\\)\\(void \\*context(.*), spisor_refusal \\*refusal\\)$")
        if(NOT member MATCHES "${status_operation}")
            message(FATAL_ERROR "${definition}'s ${operation} has a signature no rule here reads: ${member}")
        endif()
        set(between "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "^, " "" between "${between}")
        string(REPLACE ", " ";" parameters "${between}")
        set(entries "")
        set(arguments "")
        set(index 0)
        foreach(parameter_text IN LISTS parameters)
            if(NOT parameter_text MATCHES "^(const )?([A-Za-z0-9_]+) \\*[a-z0-9_]+$")
                message(FATAL_ERROR
                    "${definition}'s ${operation} takes a parameter no rule here reads: ${parameter_text}")
            endif()
            set(is_answer 1)
            if(CMAKE_MATCH_1)
                set(is_answer 0)
            endif()
            spisor_parameter_entry("${CMAKE_MATCH_2}" ${is_answer})
            list(APPEND entries "    ${parameter}")
            list(APPEND arguments "parameters[${index}]")
            math(EXPR index "${index} + 1")
        endforeach()
        if(index EQUAL 0)
            continue()
        endif()
        string(JOIN ",\n" entries ${entries})
        string(JOIN ", " arguments ${arguments})
        set(call "call_${definition}_${operation}")
        string(APPEND declarations
            "static spisor_status ${call}(const void *definition, void *const *parameters, spisor_refusal *refusal) {\n"
            "    const ${definition} *typed = definition;\n"
            "    return typed->${operation}(typed->context, ${arguments}, refusal);\n}\n"
            "static const spisor_definition_parameter parameters_of_${call}[] = {\n${entries}\n};\n")
        string(CONCAT entry "    {\"${symbol}\", \"${operation}\", ${call}, release_refusal_of_${definition}, "
            "parameters_of_${call}, ${index}}")
        list(APPEND operations "${entry}")
    endforeach()
    if(NOT has_release_refusal)
        message(FATAL_ERROR "${definition} has no release_refusal")
    endif()
    set(declarations "${declarations}" PARENT_SCOPE)
    set(operations "${operations}" PARENT_SCOPE)
endfunction()

function(spisor_generate_definition_operations)
    foreach(required IN ITEMS LAYOUTS DEFINITIONS INCLUDE_ROOT PREFIX SHAPES OUTPUT)
        if(NOT DEFINED ${required})
            message(FATAL_ERROR "${required} is required")
        endif()
    endforeach()
    string(REPLACE "," ";" shape_directories "${SHAPES}")
    foreach(directory IN LISTS shape_directories)
        file(GLOB_RECURSE headers "${directory}/*.h")
        foreach(header IN LISTS headers)
            spisor_read_first_shapes("${header}")
        endforeach()
    endforeach()
    spisor_read_layout_fields("${LAYOUTS}")
    file(GLOB definition_headers "${DEFINITIONS}/*.h")
    set(includes "")
    set(declarations "")
    set(operations "")
    set(definition_count 0)
    foreach(header IN LISTS definition_headers)
        spisor_header_code("${header}" code)
        string(REGEX MATCHALL "${PREFIX}[a-z0-9_]*_definition_of\\(void\\)" symbols "${code}")
        string(REGEX MATCHALL "typedef struct ${PREFIX}[a-z0-9_]*_definition {[^}]*}" bodies "${code}")
        list(LENGTH symbols symbol_count)
        list(LENGTH bodies body_count)
        if(NOT symbol_count EQUAL body_count)
            message(FATAL_ERROR "${header} declares ${symbol_count} definition getters and ${body_count} definitions")
        endif()
        if(body_count EQUAL 0)
            continue()
        endif()
        file(RELATIVE_PATH include "${INCLUDE_ROOT}" "${header}")
        string(APPEND includes "#include \"${include}\"\n")
        foreach(body IN LISTS bodies)
            string(REGEX MATCH "^typedef struct ([a-z0-9_]+) {(.*)}$" ignored "${body}")
            set(definition "${CMAKE_MATCH_1}")
            string(REPLACE " @ " ";" members "${CMAKE_MATCH_2}")
            set(symbol "${definition}_of")
            if(NOT "${symbol}(void)" IN_LIST symbols)
                message(FATAL_ERROR "${header} defines ${definition} and declares no ${symbol}")
            endif()
            string(APPEND declarations
                "static void release_refusal_of_${definition}(const void *definition, spisor_refusal *refusal) {\n"
                "    const ${definition} *typed = definition;\n"
                "    typed->release_refusal(typed->context, refusal);\n}\n")
            spisor_definition_entries("${definition}" "${symbol}" "${members}")
            math(EXPR definition_count "${definition_count} + 1")
        endforeach()
    endforeach()
    if(definition_count EQUAL 0 OR NOT operations)
        message(FATAL_ERROR "no definition operation under ${DEFINITIONS}, so nothing would be checked")
    endif()
    string(JOIN ",\n" operations ${operations})
    file(WRITE "${OUTPUT}.new" "#include <stddef.h>\n\n#include \"definition_calls.h\"\n${includes}\n${declarations}\n"
        "const spisor_definition_operation spisor_definition_operations[] = {\n${operations}\n};\n\n"
        "const size_t spisor_definition_operation_count = "
        "sizeof spisor_definition_operations / sizeof spisor_definition_operations[0];\n")
    file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}.new")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    spisor_generate_definition_operations()
endif()
