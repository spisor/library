{
  "$schema": "https://weivel.github.io/model/library.schema.json",
  "id": "runtime",
  "version": "0.1.0",
  "binary": "runtime",
  "release": "runtime_release",
  "services": [
    {
      "id": "boot",
      "functions": [
        {
          "name": "read",
          "symbol": "runtime_boot_read",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "cache": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 }
            },
            "required": ["cache", "hostId"]
          },
          "result": {
            "type": "object",
            "properties": {
              "hint": {
                "type": "object",
                "properties": {
                  "libraries": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "version": { "type": "string" },
                        "directory": { "type": "string" },
                        "binary": { "type": "string" }
                      },
                      "required": ["version", "directory"],
                      "additionalProperties": false
                    }
                  },
                  "host": { "type": "string" }
                },
                "required": ["libraries"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "write",
          "symbol": "runtime_boot_write",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "cache": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "libraries": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
              "host": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 },
              "platform": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9]+$" }
            },
            "required": ["cache", "hostId", "libraries"]
          },
          "result": {
            "type": "object",
            "properties": {
              "hint": {
                "type": "object",
                "properties": {
                  "libraries": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "version": { "type": "string" },
                        "directory": { "type": "string" },
                        "binary": { "type": "string" }
                      },
                      "required": ["version", "directory"],
                      "additionalProperties": false
                    }
                  },
                  "host": { "type": "string" }
                },
                "required": ["libraries"],
                "additionalProperties": false
              }
            },
            "required": ["hint"],
            "additionalProperties": false
          }
        },
        {
          "name": "resolve",
          "symbol": "runtime_boot_resolve",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "cache": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string" },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "platform": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9]+$" }
            },
            "required": ["cache"]
          },
          "result": {
            "type": "object",
            "properties": {
              "executable": { "type": "string" },
              "arguments": { "type": "array", "items": { "type": "string" } },
              "version": { "type": "string" },
              "directory": { "type": "string" }
            },
            "required": ["executable", "arguments", "version", "directory"],
            "additionalProperties": false
          }
        },
        {
          "name": "place",
          "symbol": "runtime_boot_place",
          "kind": "json",
          "argument": { "type": "object", "properties": { "cache": { "type": "string", "minLength": 1 } }, "required": ["cache"] },
          "result": { "type": "object", "properties": { "placed": { "type": "boolean" }, "path": { "type": "string" } }, "required": ["placed", "path"], "additionalProperties": false }
        }
      ]
    },
    {
      "id": "processes",
      "functions": [
        {
          "name": "hold",
          "symbol": "runtime_processes_hold",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "holder": { "type": "integer", "minimum": 1 },
              "start": {
                "type": "object",
                "description": "How to start the host, built from the start its registration records: the absolute executable, its arguments, the environment that replaces the caller's, and the folder it runs in (state by default).",
                "properties": {
                  "executable": { "type": "string", "minLength": 1 },
                  "arguments": { "type": "array", "items": { "type": "string" } },
                  "environment": { "type": "object", "additionalProperties": { "type": "string" } },
                  "directory": { "type": "string", "minLength": 1 }
                },
                "required": ["executable"]
              }
            },
            "required": ["state", "hostId", "holder", "start"]
          },
          "result": {
            "type": "object",
            "properties": {
              "pid": { "type": "integer", "minimum": 1 },
              "started": { "type": "boolean" },
              "outsideJob": { "type": "boolean" }
            },
            "required": ["pid", "started"],
            "additionalProperties": false
          }
        },
        {
          "name": "release",
          "symbol": "runtime_processes_release",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "holder": { "type": "integer", "minimum": 1 }
            },
            "required": ["state", "hostId", "holder"]
          },
          "result": {
            "type": "object",
            "properties": {
              "holders": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            },
            "required": ["holders"],
            "additionalProperties": false
          }
        },
        {
          "name": "prune",
          "symbol": "runtime_processes_prune",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "self": { "type": "integer", "minimum": 1 },
              "now": { "type": "number", "exclusiveMinimum": 0 },
              "checkMilliseconds": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["state", "hostId", "self"]
          },
          "result": {
            "type": "object",
            "properties": {
              "exit": { "type": "boolean" }
            },
            "required": ["exit"],
            "additionalProperties": false
          }
        },
        {
          "name": "ready",
          "symbol": "runtime_processes_ready",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "pid": { "type": "integer", "minimum": 1 },
              "environment": { "type": "object", "additionalProperties": { "type": "string" } },
              "refused": { "type": "string", "minLength": 1 },
              "fix": { "type": "string", "minLength": 1 }
            },
            "required": ["state", "hostId", "pid"]
          },
          "result": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "name": "awaitReady",
          "symbol": "runtime_processes_await_ready",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "pid": { "type": "integer", "minimum": 1 },
              "timeoutMilliseconds": { "type": "integer", "minimum": 1 }
            },
            "required": ["state", "hostId", "pid", "timeoutMilliseconds"]
          },
          "result": {
            "type": "object",
            "properties": {
              "environment": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "required": ["environment"],
            "additionalProperties": false
          }
        },
        {
          "name": "recordRun",
          "symbol": "runtime_processes_record_run",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "run": { "type": "object", "additionalProperties": { "type": "string" } },
              "checkMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
              "record": { "type": "string", "minLength": 1 }
            },
            "required": ["state", "hostId", "run"]
          },
          "result": {
            "type": "object",
            "properties": {
              "record": { "type": "string" }
            },
            "required": ["record"],
            "additionalProperties": false
          }
        },
        {
          "name": "liveRuns",
          "symbol": "runtime_processes_live_runs",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "now": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["state"]
          },
          "result": {
            "type": "object",
            "properties": {
              "runs": { "type": "array", "items": { "type": "object", "additionalProperties": { "type": "string" } } }
            },
            "required": ["runs"],
            "additionalProperties": false
          }
        },
        {
          "name": "removeRuns",
          "symbol": "runtime_processes_remove_runs",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "hostId": { "type": "string", "minLength": 1 },
              "record": { "type": "string", "minLength": 1 }
            },
            "required": ["state", "hostId"]
          },
          "result": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "hosts",
      "functions": [
        {
          "name": "register",
          "symbol": "runtime_hosts_register",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "state": { "type": "string", "minLength": 1 } },
                "required": ["state"]
              },
              "identity": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "home": { "type": "string" },
                  "application": { "type": "object" },
                  "requiresCommand": { "type": "boolean" },
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "target": { "type": "string", "minLength": 1 },
                        "arguments": { "type": "array", "items": { "type": "string" } }
                      },
                      "required": ["name", "target"]
                    }
                  },
                  "start": {
                    "type": "object",
                    "description": "How a launcher starts the host: the language runtime it needs and its entry, a relative path inside its installed bundle.",
                    "properties": {
                      "runtime": { "enum": ["javascript", "jvm", "native"] },
                      "entry": { "type": "string", "minLength": 1 }
                    },
                    "required": ["runtime", "entry"]
                  }
                },
                "required": ["id", "version", "requiresCommand", "commands"]
              },
              "provenance": { "type": "object" },
              "environment": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "required": ["places", "identity", "provenance", "environment"]
          },
          "result": {
            "type": "object",
            "properties": {
              "provenance": { "type": "object" },
              "commands": { "type": "array", "items": { "type": "string" } },
              "refusedCommands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "detail": { "type": "string" },
                    "fix": { "type": "string" }
                  },
                  "required": ["name", "detail", "fix"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["provenance", "commands", "refusedCommands"],
            "additionalProperties": false
          }
        },
        {
          "name": "list",
          "symbol": "runtime_hosts_list",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "state": { "type": "string", "minLength": 1 } },
                "required": ["state"]
              }
            },
            "required": ["places"]
          },
          "result": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "registration": { "type": "object" },
                    "orphan": { "type": "boolean" }
                  },
                  "required": ["registration", "orphan"],
                  "additionalProperties": false
                }
              },
              "unreadable": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["hosts", "unreadable"],
            "additionalProperties": false
          }
        },
        {
          "name": "remove",
          "symbol": "runtime_hosts_remove",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "state": { "type": "string", "minLength": 1 },
                  "cache": { "type": "string", "minLength": 1 }
                },
                "required": ["state", "cache"]
              },
              "id": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "id"]
          },
          "result": {
            "type": "object",
            "properties": {
              "reversed": { "type": "integer", "minimum": 0 },
              "drifted": { "type": "array" },
              "forgotten": { "type": "boolean" }
            },
            "required": ["reversed", "drifted", "forgotten"],
            "additionalProperties": false
          }
        },
        {
          "name": "provenance",
          "symbol": "runtime_hosts_provenance",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "object",
                "properties": {
                  "method": { "type": "string", "minLength": 1 },
                  "package": { "type": "string" },
                  "options": { "type": "object" },
                  "version": { "type": "string" }
                },
                "required": ["method"]
              },
              "application": {
                "type": "object",
                "properties": { "binary": { "type": "string", "minLength": 1 } },
                "required": ["binary"]
              },
              "home": { "type": "string", "minLength": 1 },
              "environment": { "type": "object", "additionalProperties": { "type": "string" } },
              "now": { "type": "number", "minimum": 0 }
            },
            "required": ["origin", "application", "home", "environment"]
          },
          "result": {
            "type": "object",
            "properties": {
              "method": { "type": "string" },
              "package": { "type": "string" },
              "options": { "type": "object" },
              "version": { "type": "string" },
              "location": { "type": "string" },
              "os": { "type": "string" },
              "architecture": { "type": "string" },
              "installedAt": { "type": "string" }
            },
            "required": ["method", "location", "os", "architecture", "installedAt"],
            "additionalProperties": false
          }
        },
        {
          "name": "start",
          "symbol": "runtime_hosts_start",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "environment": { "type": "object", "additionalProperties": { "type": "string" } },
              "hostId": { "type": "string", "minLength": 1 },
              "layer": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 }
                },
                "required": ["id", "version"]
              },
              "libraries": { "type": "object", "additionalProperties": { "type": "string" } },
              "session": { "type": "boolean" }
            },
            "required": ["environment", "hostId", "layer", "libraries", "session"]
          },
          "result": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "home": { "type": "string" },
                  "portable": { "type": "string" },
                  "state": { "type": "string" },
                  "cache": { "type": "string" },
                  "secretsFile": { "type": "string" },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["home", "portable", "state", "cache", "secretsFile", "forceFileStore"],
                "additionalProperties": false
              },
              "identity": {
                "type": "object",
                "properties": {
                  "version": { "type": "string" },
                  "home": { "type": "string" },
                  "requiresCommand": { "type": "boolean" },
                  "application": { "type": "object" }
                },
                "required": ["version", "home", "requiresCommand"],
                "additionalProperties": false
              },
              "settings": { "type": "object" },
              "plan": {
                "type": "object",
                "description": "updates.apply's answer; a reused recorded run carries no next or rollback.",
                "properties": {
                  "plugins": { "type": "object", "additionalProperties": { "type": "string" } },
                  "run": { "type": "object", "additionalProperties": { "type": "string" } },
                  "next": { "type": "object", "additionalProperties": { "type": "string" } },
                  "rollback": { "type": "object", "additionalProperties": { "type": "string" } },
                  "unrecorded": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": { "message": { "type": "string" }, "fix": { "type": "string" } },
                      "required": ["message", "fix"],
                      "additionalProperties": false
                    }
                  },
                  "runRecord": { "type": "string" }
                },
                "required": ["plugins", "run", "unrecorded", "runRecord"],
                "additionalProperties": false
              },
              "reusedRecordedRun": { "type": "boolean" },
              "timers": {
                "type": "object",
                "description": "Answered to the session start alone.",
                "properties": {
                  "recordRunMilliseconds": { "type": "number" },
                  "pruneFailuresBeforeExit": { "type": "integer" },
                  "updateCheckMilliseconds": { "type": "number" }
                },
                "required": ["recordRunMilliseconds", "pruneFailuresBeforeExit", "updateCheckMilliseconds"],
                "additionalProperties": false
              },
              "noColor": { "type": "boolean" }
            },
            "required": ["places", "identity", "settings", "plan", "reusedRecordedRun", "noColor"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "loader",
      "functions": [
        {
          "name": "check",
          "symbol": "runtime_loader_check",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": { "standard": {} },
            "required": ["standard"]
          },
          "result": {
            "type": "object",
            "properties": {
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "detail": { "type": "string" },
                    "fix": { "type": "string" }
                  },
                  "required": ["path", "detail", "fix"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["issues"],
            "additionalProperties": false
          }
        },
        {
          "name": "home",
          "symbol": "runtime_loader_home",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": {
                "type": "object",
                "properties": {
                  "envOverride": { "type": "string" },
                  "nativeEnv": { "type": "string" },
                  "xdgSubdir": { "type": "string" },
                  "candidates": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                },
                "required": ["candidates"]
              },
              "environment": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "required": ["home", "environment"]
          },
          "result": {
            "type": "object",
            "properties": {
              "home": { "type": "string" },
              "source": { "enum": ["override", "native", "xdg", "candidate", "default"] }
            },
            "required": ["home", "source"],
            "additionalProperties": false
          }
        },
        {
          "name": "installed",
          "symbol": "runtime_loader_installed",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "cache": { "type": "string", "minLength": 1 } },
                "required": ["cache"]
              },
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "id", "version"]
          },
          "result": {
            "type": "object",
            "properties": { "standard": { "type": "object" } },
            "required": ["standard"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "ui",
      "functions": [
        {
          "name": "navigation",
          "symbol": "runtime_ui_navigation",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "descriptions": {
                "type": "array",
                "items": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] }
              },
              "ui": { "type": "object" }
            },
            "required": ["descriptions", "ui"]
          },
          "result": {
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "plugin": { "type": "string" },
                    "kind": { "enum": ["view", "settings", "action"] },
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "pinned": { "type": "boolean" }
                  },
                  "required": ["plugin", "kind", "id", "pinned"],
                  "additionalProperties": false
                }
              },
              "preferences": { "type": "object" }
            },
            "required": ["entries", "preferences"],
            "additionalProperties": false
          }
        },
        {
          "name": "settingsView",
          "symbol": "runtime_ui_settings_view",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "description": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] }
            },
            "required": ["description"]
          },
          "result": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "parent": { "type": "string" },
                    "component": { "enum": ["form", "field"] },
                    "field": { "type": "string" },
                    "label": { "type": "string" }
                  },
                  "required": ["id", "component"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["title", "nodes"],
            "additionalProperties": false
          }
        },
        {
          "name": "plan",
          "symbol": "runtime_ui_plan",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "descriptions": {
                "type": "array",
                "items": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] }
              },
              "screen": {
                "type": "object",
                "properties": {
                  "plugin": { "type": "string" },
                  "kind": { "enum": ["view", "settings", "action"] },
                  "id": { "type": "string" }
                },
                "required": ["plugin", "kind"]
              },
              "answers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
