# spisor_refuse_test_only_links(<root directory>) fails the configure when a shipped target reaches a test-only one. It
# defers the check to the end of the top-level directory, so it sees every target and property the whole configure
# sets, including what is set after the call. A project that adds this repository with add_subdirectory calls it too,
# with its own root, so its targets are checked against every test-only target of the whole tree.
#
# A target is test-only when it carries the SPISOR_TEST_ONLY property. A target is shipped when it is not test-only and
# is defined outside every directory named `test` below the root. A shipped target is refused when, at any depth of
# what it reaches:
#  - a target names a test-only target in its LINK_LIBRARIES, INTERFACE_LINK_LIBRARIES, LINK_OPTIONS,
#    INTERFACE_LINK_OPTIONS or LINK_FLAGS, or takes its objects with $<TARGET_OBJECTS:...> among its SOURCES;
#  - one of those link items is a path or a flag naming a test-only target's file, by its output name;
#  - a source lies under a directory named `test` or `testing` below the root, a path inside a generator expression
#    included;
#  - a target carries, in its COMPILE_DEFINITIONS or INTERFACE_COMPILE_DEFINITIONS, a definition a test-only target
#    carries, so a shipped build of a test hook's source is refused for the definition that makes it a hook.
# Every word of a generator expression counts, whatever condition guards it, so a link that holds in only one
# configuration is refused in all of them. Each offence is printed once.
#
# The same call holds every binary to one allocator. A target carrying the SPISOR_ALLOCATOR property is one; a library
# that reaches one is refused, since only an executable or a shared or module library chooses its allocator, and such a
# binary that reaches two is refused.

include_guard(GLOBAL)

function(spisor_link_graph_targets directory out)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        spisor_link_graph_targets("${subdirectory}" nested)
        list(APPEND targets ${nested})
    endforeach()
    set(${out} "${targets}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_words out)
    set(words "")
    foreach(item IN LISTS ARGN)
        string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" found "${item}")
        list(APPEND words ${found})
    endforeach()
    set(${out} "${words}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_named_targets out)
    spisor_link_graph_words(words ${ARGN})
    set(named "")
    foreach(word IN LISTS words)
        if(TARGET "${word}")
            get_target_property(aliased "${word}" ALIASED_TARGET)
            if(aliased)
                list(APPEND named "${aliased}")
            else()
                list(APPEND named "${word}")
            endif()
        endif()
    endforeach()
    set(${out} "${named}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_link_items target out)
    get_target_property(type "${target}" TYPE)
    set(properties INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        list(APPEND properties LINK_LIBRARIES LINK_OPTIONS LINK_FLAGS STATIC_LIBRARY_FLAGS STATIC_LIBRARY_OPTIONS)
        foreach(configuration IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            list(APPEND properties LINK_FLAGS_${configuration} STATIC_LIBRARY_FLAGS_${configuration})
        endforeach()
    endif()
    set(items "")
    foreach(property IN LISTS properties)
        get_target_property(values "${target}" ${property})
        if(values)
            list(APPEND items ${values})
        endif()
    endforeach()
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_sources target out)
    get_target_property(type "${target}" TYPE)
    set(sources "")
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        get_target_property(sources "${target}" SOURCES)
        if(NOT sources)
            set(sources "")
        endif()
    endif()
    set(${out} "${sources}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_edges target out)
    spisor_link_graph_link_items("${target}" items)
    spisor_link_graph_sources("${target}" sources)
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<TARGET_OBJECTS:")
            list(APPEND items "${source}")
        endif()
    endforeach()
    spisor_link_graph_named_targets(named ${items})
    set(${out} "${named}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_file_stem target out)
    get_target_property(name "${target}" OUTPUT_NAME)
    if(NOT name)
        get_target_property(name "${target}" ARCHIVE_OUTPUT_NAME)
    endif()
    if(NOT name)
        set(name "${target}")
    endif()
    set(${out} "${name}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_word_stem word out)
    string(REGEX REPLACE "^-l" "" stem "${word}")
    string(REGEX REPLACE "\\..*$" "" stem "${stem}")
    set(${out} "${stem}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_named_files target test_only out)
    spisor_link_graph_link_items("${target}" items)
    spisor_link_graph_words(words ${items})
    set(found "")
    foreach(word IN LISTS words)
        if(TARGET "${word}")
            continue()
        endif()
        spisor_link_graph_word_stem("${word}" stem)
        foreach(candidate IN LISTS test_only)
            spisor_link_graph_file_stem("${candidate}" file_stem)
            if(stem STREQUAL file_stem OR stem STREQUAL "lib${file_stem}")
                list(APPEND found "${candidate}")
            endif()
        endforeach()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_source_paths target out)
    spisor_link_graph_sources("${target}" sources)
    get_target_property(source_directory "${target}" SOURCE_DIR)
    set(paths "")
    foreach(source IN LISTS sources)
        set(candidates "${source}")
        if(source MATCHES "\\$<")
            string(REGEX REPLACE "[<>,]" ";" candidates "${source}")
        endif()
        foreach(candidate IN LISTS candidates)
            string(REGEX REPLACE "^\\$+" "" candidate "${candidate}")
            if(candidate MATCHES "^[A-Za-z_]+:(.*)$" AND NOT candidate MATCHES "^[A-Za-z]:[/\\\\]")
                set(candidate "${CMAKE_MATCH_1}")
            endif()
            string(REGEX REPLACE "^:" "" candidate "${candidate}")
            if(NOT candidate STREQUAL "")
                get_filename_component(path "${candidate}" ABSOLUTE BASE_DIR "${source_directory}")
                list(APPEND paths "${path}")
            endif()
        endforeach()
    endforeach()
    set(${out} "${paths}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_test_directory_sources root target out)
    spisor_link_graph_source_paths("${target}" paths)
    set(found "")
    foreach(path IN LISTS paths)
        file(RELATIVE_PATH relative "${root}" "${path}")
        if("/${relative}" MATCHES "/(test|testing)/")
            list(APPEND found "${path}")
        endif()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_definitions target out)
    get_target_property(type "${target}" TYPE)
    set(properties INTERFACE_COMPILE_DEFINITIONS)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        list(APPEND properties COMPILE_DEFINITIONS)
    endif()
    set(names "")
    foreach(property IN LISTS properties)
        get_target_property(values "${target}" ${property})
        if(values)
            foreach(value IN LISTS values)
                string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*(=[^;>]*)?" words "${value}")
                foreach(word IN LISTS words)
                    string(REGEX REPLACE "=.*$" "" word "${word}")
                    list(APPEND names "${word}")
                endforeach()
            endforeach()
        endif()
    endforeach()
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_test_definitions test_only out)
    set(found "")
    foreach(target IN LISTS test_only)
        spisor_link_graph_definitions("${target}" names)
        list(APPEND found ${names})
    endforeach()
    if(found)
        list(REMOVE_DUPLICATES found)
    endif()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_carried_definitions target test_definitions out)
    spisor_link_graph_definitions("${target}" names)
    set(found "")
    foreach(name IN LISTS names)
        if(name IN_LIST test_definitions)
            list(APPEND found "${name}")
        endif()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_is_shipped root target out)
    get_target_property(test_only "${target}" SPISOR_TEST_ONLY)
    get_target_property(source_directory "${target}" SOURCE_DIR)
    file(RELATIVE_PATH relative "${root}" "${source_directory}")
    if(test_only OR "/${relative}/" MATCHES "/test/")
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(spisor_link_graph_offences root start test_only test_definitions out)
    set(pending "${start}")
    set(seen "${start}")
    set(offences "")
    while(pending)
        list(POP_FRONT pending current)
        spisor_link_graph_named_files("${current}" "${test_only}" files)
        foreach(found IN LISTS files)
            list(APPEND offences "${start} is shipped and names the file of the test-only ${found} (through ${current})")
        endforeach()
        spisor_link_graph_test_directory_sources("${root}" "${current}" taken)
        foreach(found IN LISTS taken)
            list(APPEND offences "${start} is shipped and takes the source ${found} from a test directory (through ${current})")
        endforeach()
        spisor_link_graph_carried_definitions("${current}" "${test_definitions}" carried)
        foreach(found IN LISTS carried)
            list(APPEND offences "${start} is shipped and carries the test-only definition ${found} (through ${current})")
        endforeach()
        spisor_link_graph_edges("${current}" edges)
        foreach(edge IN LISTS edges)
            if(NOT edge IN_LIST seen)
                list(APPEND seen "${edge}")
                get_target_property(edge_test_only "${edge}" SPISOR_TEST_ONLY)
                if(edge_test_only)
                    list(APPEND offences "${start} is shipped and reaches the test-only ${edge} (through ${current})")
                else()
                    list(APPEND pending "${edge}")
                endif()
            endif()
        endforeach()
    endwhile()
    set(${out} "${offences}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_closure start out)
    set(pending "${start}")
    set(seen "${start}")
    while(pending)
        list(POP_FRONT pending current)
        spisor_link_graph_edges("${current}" edges)
        foreach(edge IN LISTS edges)
            if(NOT edge IN_LIST seen)
                list(APPEND seen "${edge}")
                list(APPEND pending "${edge}")
            endif()
        endforeach()
    endwhile()
    list(REMOVE_ITEM seen "${start}")
    set(${out} "${seen}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_allocator_offences targets out)
    set(offences "")
    foreach(target IN LISTS targets)
        get_target_property(is_allocator "${target}" SPISOR_ALLOCATOR)
        if(is_allocator)
            continue()
        endif()
        spisor_link_graph_closure("${target}" reached)
        set(allocators "")
        foreach(candidate IN LISTS reached)
            get_target_property(candidate_is_allocator "${candidate}" SPISOR_ALLOCATOR)
            if(candidate_is_allocator)
                list(APPEND allocators "${candidate}")
            endif()
        endforeach()
        list(LENGTH allocators count)
        get_target_property(type "${target}" TYPE)
        string(REPLACE ";" ", " names "${allocators}")
        if(type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            if(count GREATER 1)
                list(APPEND offences "${target} links ${count} allocators: ${names}")
            endif()
        elseif(count GREATER 0)
            list(APPEND offences "${target} is a library and carries the allocator ${names}")
        endif()
    endforeach()
    set(${out} "${offences}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_check root)
    spisor_link_graph_targets("${root}" targets)
    set(test_only "")
    foreach(target IN LISTS targets)
        get_target_property(flag "${target}" SPISOR_TEST_ONLY)
        if(flag)
            list(APPEND test_only "${target}")
        endif()
    endforeach()
    spisor_link_graph_test_definitions("${test_only}" test_definitions)
    set(offenders "")
    foreach(target IN LISTS targets)
        spisor_link_graph_is_shipped("${root}" "${target}" shipped)
        if(shipped)
            spisor_link_graph_offences("${root}" "${target}" "${test_only}" "${test_definitions}" offences)
            list(APPEND offenders ${offences})
        endif()
    endforeach()
    spisor_link_graph_allocator_offences("${targets}" allocator_offences)
    list(APPEND offenders ${allocator_offences})
    if(offenders)
        list(REMOVE_DUPLICATES offenders)
        string(REPLACE ";" "\n" report "${offenders}")
        message(FATAL_ERROR "${report}")
    endif()
endfunction()

function(spisor_refuse_test_only_links root)
    cmake_language(EVAL CODE "cmake_language(DEFER DIRECTORY [[${CMAKE_SOURCE_DIR}]] CALL spisor_link_graph_check [[${root}]])")
endfunction()
