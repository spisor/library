# -DSCENARIO=<name> -DWORK=<dir> -DLINK_GRAPH=<link_graph.cmake> -DGENERATOR=<cmake generator>
#
# Each scenario writes a probe project with no language into WORK, links a test-only target into it one way, and
# configures it. The probe ends in a deliberate error once the check has passed, so it never needs a compiler.

cmake_minimum_required(VERSION 3.15)

set(root "${WORK}/${SCENARIO}")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/source/test")

set(preamble "cmake_minimum_required(VERSION 3.15)\nproject(probe NONE)\ninclude(\"${LINK_GRAPH}\")\n")
set(preamble "${preamble}add_library(reader STATIC reader.c)\nset_target_properties(reader PROPERTIES SPISOR_TEST_ONLY TRUE)\n")
set(closing "add_subdirectory(test)\nspisor_refuse_test_only_links(\"\${CMAKE_CURRENT_SOURCE_DIR}\")\nmessage(FATAL_ERROR \"the link graph passed\")\n")

function(probe body test_body)
    file(WRITE "${root}/source/CMakeLists.txt" "${preamble}${body}\n${closing}")
    file(WRITE "${root}/source/test/CMakeLists.txt" "${test_body}\n")
endfunction()

function(expect must_match)
    execute_process(COMMAND ${CMAKE_COMMAND} -G "${GENERATOR}" -S "${root}/source" -B "${root}/build"
                    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(REGEX REPLACE "[ \t\r\n]+" " " output "${out}${err}")
    if(NOT output MATCHES "${must_match}")
        message(FATAL_ERROR "${SCENARIO}: output does not match '${must_match}'\n${output}")
    endif()
endfunction()

function(expect_once message)
    execute_process(COMMAND ${CMAKE_COMMAND} -G "${GENERATOR}" -S "${root}/source" -B "${root}/build"
                    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(REGEX REPLACE "[ \t\r\n]+" " " output "${out}${err}")
    string(REPLACE "${message}" "" without "${output}")
    string(LENGTH "${output}" with_length)
    string(LENGTH "${without}" without_length)
    string(LENGTH "${message}" message_length)
    math(EXPR times "(${with_length} - ${without_length}) / ${message_length}")
    if(NOT times EQUAL 1)
        message(FATAL_ERROR "${SCENARIO}: '${message}' printed ${times} times\n${output}")
    endif()
endfunction()

set(test_links_reader "add_executable(reader_test reader_test.c)\ntarget_link_libraries(reader_test PRIVATE reader)")
set(refused "is shipped and reaches the test-only reader")

if(SCENARIO STREQUAL "link_graph_lets_a_test_link_the_reader")
    probe("add_library(shipped SHARED shipped.c)" "${test_links_reader}")
    expect("the link graph passed")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_direct_link")
    probe("add_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE reader)" "")
    expect("shipped ${refused} \\(through shipped\\)")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_link_through_another_library")
    probe("add_library(middle STATIC middle.c)\ntarget_link_libraries(middle PRIVATE reader)\nadd_executable(shipped shipped.c)\ntarget_link_libraries(shipped PRIVATE middle)" "")
    expect("shipped ${refused} \\(through middle\\)")
elseif(SCENARIO STREQUAL "link_graph_refuses_objects_taken_from_the_reader")
    probe("add_library(reader_objects OBJECT reader.c)\nset_target_properties(reader_objects PROPERTIES SPISOR_TEST_ONLY TRUE)\nadd_library(shipped SHARED shipped.c $<TARGET_OBJECTS:reader_objects>)" "")
    expect("shipped is shipped and reaches the test-only reader_objects")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_link_under_a_condition")
    probe("add_library(bundle INTERFACE)\ntarget_link_libraries(bundle INTERFACE $<$<CONFIG:Debug>:reader>)\nadd_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE bundle)" "")
    expect("shipped ${refused} \\(through bundle\\)")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_link_through_an_alias")
    probe("add_library(probe::reader ALIAS reader)\nadd_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE probe::reader)" "")
    expect("shipped ${refused} \\(through shipped\\)")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_shipped_target_in_a_directory_only_named_like_a_test")
    file(MAKE_DIRECTORY "${root}/source/tests")
    file(WRITE "${root}/source/tests/CMakeLists.txt" "add_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE reader)\n")
    probe("add_subdirectory(tests)" "")
    expect("shipped ${refused}")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_source_only_a_test_only_target_lists")
    file(MAKE_DIRECTORY "${root}/source/testing")
    file(WRITE "${root}/source/testing/CMakeLists.txt" "add_library(testing_reader STATIC testing_reader.c)\nset_target_properties(testing_reader PROPERTIES SPISOR_TEST_ONLY TRUE)\n")
    probe("add_subdirectory(testing)\nadd_library(shipped SHARED shipped.c)\ntarget_sources(shipped PRIVATE \${CMAKE_CURRENT_SOURCE_DIR}/testing/testing_reader.c)" "")
    expect("shipped is shipped and takes the source .*testing/testing_reader.c from the test-only testing_reader")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_raw_path_to_the_readers_file")
    probe("add_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE \${CMAKE_CURRENT_BINARY_DIR}/Debug/reader.lib)" "")
    expect("shipped is shipped and names the file of the test-only reader")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_link_option_naming_the_readers_file")
    probe("add_library(shipped SHARED shipped.c)\ntarget_link_options(shipped PRIVATE $<TARGET_FILE:reader>)" "")
    expect("shipped ${refused} \\(through shipped\\)")
elseif(SCENARIO STREQUAL "link_graph_checks_from_the_root_of_a_project_that_adds_this_one")
    file(MAKE_DIRECTORY "${root}/source/inner/test")
    file(WRITE "${root}/source/inner/CMakeLists.txt" "include(\"${LINK_GRAPH}\")\nadd_library(inner_reader STATIC inner_reader.c)\nset_target_properties(inner_reader PROPERTIES SPISOR_TEST_ONLY TRUE)\nadd_subdirectory(test)\nspisor_refuse_test_only_links(\"\${CMAKE_CURRENT_SOURCE_DIR}\")\n")
    file(WRITE "${root}/source/inner/test/CMakeLists.txt" "add_executable(inner_test inner_test.c)\ntarget_link_libraries(inner_test PRIVATE inner_reader)\n")
    probe("add_subdirectory(inner)\nadd_library(outer SHARED outer.c)\ntarget_link_libraries(outer PRIVATE inner_reader)" "")
    expect("outer is shipped and reaches the test-only inner_reader \\(through outer\\)")
elseif(SCENARIO STREQUAL "link_graph_lets_a_test_hook_twin_share_its_sources")
    file(MAKE_DIRECTORY "${root}/source/lib")
    file(WRITE "${root}/source/lib/CMakeLists.txt" "add_library(fetch STATIC fetch.c)\nadd_library(fetch_test_hooks STATIC fetch.c fetch_fake.c)\nset_target_properties(fetch_test_hooks PROPERTIES SPISOR_TEST_ONLY TRUE)\n")
    probe("add_subdirectory(lib)\nadd_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE fetch)" "add_executable(fetch_test fetch_test.c)\ntarget_link_libraries(fetch_test PRIVATE fetch_test_hooks)")
    expect("the link graph passed")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_link_flag_naming_the_readers_file")
    probe("add_library(shipped SHARED shipped.c)\nset_target_properties(shipped PROPERTIES LINK_FLAGS \"\${CMAKE_CURRENT_BINARY_DIR}/Debug/reader.lib\")" "")
    expect("shipped is shipped and names the file of the test-only reader")
elseif(SCENARIO STREQUAL "link_graph_prints_each_offence_once")
    probe("add_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE \${CMAKE_CURRENT_BINARY_DIR}/Debug/reader.lib)\ntarget_link_options(shipped PRIVATE \${CMAKE_CURRENT_BINARY_DIR}/Debug/reader.lib)" "")
    expect_once("shipped is shipped and names the file of the test-only reader (through shipped)")
elseif(SCENARIO STREQUAL "link_graph_lets_a_binary_choose_one_allocator")
    probe("add_library(allocator OBJECT allocator.c)\nset_target_properties(allocator PROPERTIES SPISOR_ALLOCATOR TRUE)\nadd_library(library STATIC library.c)\nadd_executable(application application.c)\ntarget_link_libraries(application PRIVATE library allocator)" "")
    expect("the link graph passed")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_library_carrying_an_allocator")
    probe("add_library(allocator OBJECT allocator.c)\nset_target_properties(allocator PROPERTIES SPISOR_ALLOCATOR TRUE)\nadd_library(library STATIC library.c)\ntarget_link_libraries(library PUBLIC allocator)" "")
    expect("library is a library and carries the allocator allocator")
elseif(SCENARIO STREQUAL "link_graph_refuses_a_binary_with_two_allocators")
    probe("add_library(allocator OBJECT allocator.c)\nadd_library(counting OBJECT counting.c)\nset_target_properties(allocator counting PROPERTIES SPISOR_ALLOCATOR TRUE)\nadd_library(library STATIC library.c)\nadd_executable(application application.c)\ntarget_link_libraries(application PRIVATE library allocator counting)" "")
    expect("application links 2 allocators: allocator, counting")
elseif(SCENARIO STREQUAL "link_graph_lets_a_test_build_compile_sources_from_elsewhere")
    file(MAKE_DIRECTORY "${root}/source/lib" "${root}/source/testing")
    file(WRITE "${root}/source/lib/CMakeLists.txt" "add_library(library STATIC library.c)\n")
    file(WRITE "${root}/source/testing/CMakeLists.txt" "add_library(library_testing STATIC \${CMAKE_CURRENT_SOURCE_DIR}/../lib/library.c)\nset_target_properties(library_testing PROPERTIES SPISOR_TEST_ONLY TRUE)\n")
    probe("add_subdirectory(lib)\nadd_subdirectory(testing)\nadd_library(shipped SHARED shipped.c)\ntarget_link_libraries(shipped PRIVATE library)" "")
    expect("the link graph passed")
else()
    message(FATAL_ERROR "unknown SCENARIO '${SCENARIO}'")
endif()
