# spisor_refuse_test_only_links(<root directory>) fails the configure when a shipped target reaches a test-only one. A
# project that adds this repository with add_subdirectory includes this file and calls it at its own end with its own
# root, so its targets are checked against every test-only target of the whole tree.
#
# A target is test-only when it carries the SPISOR_TEST_ONLY property. A target is shipped when it is not test-only and
# is defined outside every directory named `test` below the root. A shipped target is refused when, at any depth of
# what it reaches:
#  - a target names a test-only target in its LINK_LIBRARIES, INTERFACE_LINK_LIBRARIES, LINK_OPTIONS or
#    INTERFACE_LINK_OPTIONS, or takes its objects with $<TARGET_OBJECTS:...> among its SOURCES;
#  - one of those link items is a path or a flag naming a test-only target's file, by its output name;
#  - a source lies in the directory a test-only target is defined in, other than the root itself.
# Every word of a generator expression counts, whatever condition guards it, so a link that holds in only one
# configuration is refused in all of them.

include_guard(GLOBAL)

function(spisor_link_graph_targets directory out)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        spisor_link_graph_targets("${subdirectory}" nested)
        list(APPEND targets ${nested})
    endforeach()
    set(${out} "${targets}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_words out)
    set(words "")
    foreach(item IN LISTS ARGN)
        string(REGEX MATCHALL "[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*" found "${item}")
        list(APPEND words ${found})
    endforeach()
    set(${out} "${words}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_named_targets out)
    spisor_link_graph_words(words ${ARGN})
    set(named "")
    foreach(word IN LISTS words)
        if(TARGET "${word}")
            get_target_property(aliased "${word}" ALIASED_TARGET)
            if(aliased)
                list(APPEND named "${aliased}")
            else()
                list(APPEND named "${word}")
            endif()
        endif()
    endforeach()
    set(${out} "${named}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_link_items target out)
    get_target_property(type "${target}" TYPE)
    set(properties INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        list(APPEND properties LINK_LIBRARIES LINK_OPTIONS)
    endif()
    set(items "")
    foreach(property IN LISTS properties)
        get_target_property(values "${target}" ${property})
        if(values)
            list(APPEND items ${values})
        endif()
    endforeach()
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_sources target out)
    get_target_property(type "${target}" TYPE)
    set(sources "")
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
        get_target_property(sources "${target}" SOURCES)
        if(NOT sources)
            set(sources "")
        endif()
    endif()
    set(${out} "${sources}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_edges target out)
    spisor_link_graph_link_items("${target}" items)
    spisor_link_graph_sources("${target}" sources)
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<TARGET_OBJECTS:")
            list(APPEND items "${source}")
        endif()
    endforeach()
    spisor_link_graph_named_targets(named ${items})
    set(${out} "${named}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_file_stem target out)
    get_target_property(name "${target}" OUTPUT_NAME)
    if(NOT name)
        get_target_property(name "${target}" ARCHIVE_OUTPUT_NAME)
    endif()
    if(NOT name)
        set(name "${target}")
    endif()
    set(${out} "${name}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_word_stem word out)
    string(REGEX REPLACE "^-l" "" stem "${word}")
    string(REGEX REPLACE "\\..*$" "" stem "${stem}")
    set(${out} "${stem}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_named_files target test_only out)
    spisor_link_graph_link_items("${target}" items)
    spisor_link_graph_words(words ${items})
    set(found "")
    foreach(word IN LISTS words)
        if(TARGET "${word}")
            continue()
        endif()
        spisor_link_graph_word_stem("${word}" stem)
        foreach(candidate IN LISTS test_only)
            spisor_link_graph_file_stem("${candidate}" file_stem)
            if(stem STREQUAL file_stem OR stem STREQUAL "lib${file_stem}")
                list(APPEND found "${candidate}")
            endif()
        endforeach()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_is_under path directory out)
    string(LENGTH "${directory}/" length)
    string(SUBSTRING "${path}" 0 ${length} start)
    if(WIN32)
        string(TOLOWER "${start}" start)
        string(TOLOWER "${directory}/" directory)
    else()
        set(directory "${directory}/")
    endif()
    if(start STREQUAL directory)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(spisor_link_graph_taken_sources target directories out)
    spisor_link_graph_sources("${target}" sources)
    get_target_property(source_directory "${target}" SOURCE_DIR)
    set(found "")
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<")
            set(path "${source}")
        else()
            get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${source_directory}")
        endif()
        file(TO_CMAKE_PATH "${path}" path)
        foreach(entry IN LISTS directories)
            string(REPLACE "|" ";" pair "${entry}")
            list(GET pair 0 owner)
            list(GET pair 1 directory)
            if(source MATCHES "\\$<")
                string(FIND "${path}" "${directory}/" at)
                set(inside FALSE)
                if(NOT at EQUAL -1)
                    set(inside TRUE)
                endif()
            else()
                spisor_link_graph_is_under("${path}" "${directory}" inside)
            endif()
            if(inside)
                list(APPEND found "${path} from the test-only ${owner}")
            endif()
        endforeach()
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_test_only_directories root test_only out)
    file(TO_CMAKE_PATH "${root}" root)
    set(directories "")
    foreach(target IN LISTS test_only)
        get_target_property(directory "${target}" SOURCE_DIR)
        file(TO_CMAKE_PATH "${directory}" directory)
        if(NOT directory STREQUAL root)
            list(APPEND directories "${target}|${directory}")
        endif()
    endforeach()
    set(${out} "${directories}" PARENT_SCOPE)
endfunction()

function(spisor_link_graph_is_shipped root target out)
    get_target_property(test_only "${target}" SPISOR_TEST_ONLY)
    get_target_property(source_directory "${target}" SOURCE_DIR)
    file(RELATIVE_PATH relative "${root}" "${source_directory}")
    if(test_only OR "/${relative}/" MATCHES "/test/")
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(spisor_link_graph_offences start test_only directories out)
    set(pending "${start}")
    set(seen "${start}")
    set(offences "")
    while(pending)
        list(POP_FRONT pending current)
        spisor_link_graph_named_files("${current}" "${test_only}" files)
        foreach(found IN LISTS files)
            list(APPEND offences "${start} is shipped and names the file of the test-only ${found} (through ${current})")
        endforeach()
        spisor_link_graph_taken_sources("${current}" "${directories}" taken)
        foreach(found IN LISTS taken)
            list(APPEND offences "${start} is shipped and takes the source ${found} (through ${current})")
        endforeach()
        spisor_link_graph_edges("${current}" edges)
        foreach(edge IN LISTS edges)
            if(NOT edge IN_LIST seen)
                list(APPEND seen "${edge}")
                get_target_property(edge_test_only "${edge}" SPISOR_TEST_ONLY)
                if(edge_test_only)
                    list(APPEND offences "${start} is shipped and reaches the test-only ${edge} (through ${current})")
                else()
                    list(APPEND pending "${edge}")
                endif()
            endif()
        endforeach()
    endwhile()
    set(${out} "${offences}" PARENT_SCOPE)
endfunction()

function(spisor_refuse_test_only_links root)
    spisor_link_graph_targets("${root}" targets)
    set(test_only "")
    foreach(target IN LISTS targets)
        get_target_property(flag "${target}" SPISOR_TEST_ONLY)
        if(flag)
            list(APPEND test_only "${target}")
        endif()
    endforeach()
    spisor_link_graph_test_only_directories("${root}" "${test_only}" directories)
    set(offenders "")
    foreach(target IN LISTS targets)
        spisor_link_graph_is_shipped("${root}" "${target}" shipped)
        if(shipped)
            spisor_link_graph_offences("${target}" "${test_only}" "${directories}" offences)
            list(APPEND offenders ${offences})
        endif()
    endforeach()
    if(offenders)
        string(REPLACE ";" "\n" report "${offenders}")
        message(FATAL_ERROR "${report}")
    endif()
endfunction()
