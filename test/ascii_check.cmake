file(GLOB_RECURSE headers "${DIRECTORY}/*")
set(offenders "")
foreach(header IN LISTS headers)
    file(READ "${header}" content HEX)
    string(REGEX MATCHALL "[0-9a-f][0-9a-f]" bytes "${content}")
    list(FILTER bytes INCLUDE REGEX "^[89a-f]")
    if(bytes)
        list(APPEND offenders "${header}")
    endif()
endforeach()
if(offenders)
    message(FATAL_ERROR "non-ASCII bytes in public headers: ${offenders}")
endif()
list(LENGTH headers count)
message(STATUS "${count} public headers are ASCII")
