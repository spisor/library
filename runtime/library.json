{
  "$schema": "https://weivel.github.io/model/library.schema.json",
  "id": "runtime",
  "version": "0.1.0",
  "binary": "runtime",
  "release": "runtime_release",
  "services": [
    {
      "id": "paths",
      "functions": [
        {
          "name": "resolve",
          "symbol": "runtime_paths_resolve",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "plugin": { "type": "string" },
              "places": {
                "type": "object",
                "properties": {
                  "portable": { "type": "string", "minLength": 1 },
                  "cache": { "type": "string", "minLength": 1 }
                },
                "required": ["portable", "cache"]
              }
            },
            "required": ["home"]
          },
          "result": {
            "type": "object",
            "properties": {
              "home": { "type": "string" },
              "repos": { "type": "string" },
              "plugin": { "type": "string" },
              "cache": { "type": "string" },
              "config": { "type": "string" },
              "portable": { "type": "string" },
              "pluginCache": { "type": "string" }
            },
            "required": ["home", "repos", "plugin", "cache", "config"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "places",
      "functions": [
        {
          "name": "resolve",
          "symbol": "runtime_places_resolve",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "environment": { "type": "object" }
            },
            "required": ["home"]
          },
          "result": {
            "type": "object",
            "properties": {
              "portable": { "type": "string" },
              "state": { "type": "string" },
              "cache": { "type": "string" },
              "secretsFile": { "type": "string" },
              "forceFileStore": { "type": "boolean" }
            },
            "required": ["portable", "state", "cache", "secretsFile", "forceFileStore"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "config",
      "functions": [
        {
          "name": "all",
          "symbol": "runtime_config_all",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "portable": { "type": "string", "minLength": 1 },
              "plugin": { "type": "string" },
              "config": { "type": "object" }
            },
            "required": ["home", "plugin"]
          },
          "result": {
            "type": "object",
            "properties": { "values": { "type": "object" } },
            "required": ["values"],
            "additionalProperties": false
          }
        },
        {
          "name": "get",
          "symbol": "runtime_config_get",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "portable": { "type": "string", "minLength": 1 },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "key": { "type": "string" }
            },
            "required": ["home", "plugin", "key"]
          },
          "result": {
            "type": "object",
            "properties": { "value": {} },
            "additionalProperties": false
          }
        },
        {
          "name": "set",
          "symbol": "runtime_config_set",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "portable": { "type": "string", "minLength": 1 },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "key": { "type": "string" },
              "value": {},
              "layer": { "enum": ["application", "portable"] }
            },
            "required": ["home", "plugin", "key", "value"]
          },
          "result": {
            "type": "object",
            "properties": { "previous": {} },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "log",
      "functions": [
        {
          "name": "write",
          "symbol": "runtime_log_write",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "portable": { "type": "string", "minLength": 1 },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "start": { "type": "string" },
              "time": { "type": "string" },
              "level": { "enum": ["debug", "info", "warn", "error"] },
              "message": { "type": "string" },
              "noColor": { "type": "boolean" }
            },
            "required": ["home", "plugin", "start", "time", "level", "message", "noColor"]
          },
          "result": {
            "type": "object",
            "properties": { "console": { "type": "string" } },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "secrets",
      "functions": [
        {
          "name": "get",
          "symbol": "runtime_secrets_get",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "secretsFile": { "type": "string", "minLength": 1 },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["secretsFile", "forceFileStore"]
              },
              "plugin": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "plugin", "name"]
          },
          "result": {
            "type": "object",
            "properties": { "value": { "type": "string" } },
            "additionalProperties": false
          }
        },
        {
          "name": "set",
          "symbol": "runtime_secrets_set",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "secretsFile": { "type": "string", "minLength": 1 },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["secretsFile", "forceFileStore"]
              },
              "plugin": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            },
            "required": ["places", "plugin", "name", "value"]
          },
          "result": {
            "type": "object",
            "properties": { "place": { "enum": ["store", "file"] } },
            "required": ["place"],
            "additionalProperties": false
          }
        },
        {
          "name": "delete",
          "symbol": "runtime_secrets_delete",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "secretsFile": { "type": "string", "minLength": 1 },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["secretsFile", "forceFileStore"]
              },
              "plugin": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "plugin", "name"]
          },
          "result": { "type": "object", "additionalProperties": false }
        },
        {
          "name": "clear",
          "symbol": "runtime_secrets_clear",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "secretsFile": { "type": "string", "minLength": 1 },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["secretsFile", "forceFileStore"]
              },
              "plugin": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" }
            },
            "required": ["places", "plugin"]
          },
          "result": { "type": "object", "additionalProperties": false }
        },
        {
          "name": "reconcile",
          "symbol": "runtime_secrets_reconcile",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "secretsFile": { "type": "string", "minLength": 1 },
                  "forceFileStore": { "type": "boolean" }
                },
                "required": ["secretsFile", "forceFileStore"]
              }
            },
            "required": ["places"]
          },
          "result": {
            "type": "object",
            "properties": { "moved": { "type": "integer", "minimum": 0 } },
            "required": ["moved"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "registry",
      "functions": [
        {
          "name": "register",
          "symbol": "runtime_registry_register",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "state": { "type": "string", "minLength": 1 } },
                "required": ["state"]
              },
              "registration": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "const": "host" },
                  "version": { "type": "string", "minLength": 1 },
                  "home": { "type": "string" },
                  "application": { "type": "object" },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "method": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "minLength": 1 },
                      "location": { "type": "string", "minLength": 1 }
                    },
                    "required": ["method", "version", "location"]
                  },
                  "requiresCommand": { "type": "boolean" }
                },
                "required": ["id", "kind", "version", "provenance", "requiresCommand"]
              }
            },
            "required": ["places", "registration"]
          },
          "result": {
            "type": "object",
            "properties": { "registration": { "type": "object" } },
            "required": ["registration"],
            "additionalProperties": false
          }
        },
        {
          "name": "get",
          "symbol": "runtime_registry_get",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "state": { "type": "string", "minLength": 1 } },
                "required": ["state"]
              },
              "id": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "id"]
          },
          "result": {
            "type": "object",
            "properties": { "registration": { "type": "object" } },
            "additionalProperties": false
          }
        },
        {
          "name": "list",
          "symbol": "runtime_registry_list",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": { "state": { "type": "string", "minLength": 1 } },
                "required": ["state"]
              }
            },
            "required": ["places"]
          },
          "result": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "registration": { "type": "object" },
                    "orphan": { "type": "boolean" }
                  },
                  "required": ["registration", "orphan"],
                  "additionalProperties": false
                }
              },
              "unreadable": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["hosts", "unreadable"],
            "additionalProperties": false
          }
        },
        {
          "name": "forget",
          "symbol": "runtime_registry_forget",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "places": {
                "type": "object",
                "properties": {
                  "state": { "type": "string", "minLength": 1 },
                  "cache": { "type": "string", "minLength": 1 }
                },
                "required": ["state", "cache"]
              },
              "id": { "type": "string", "minLength": 1 }
            },
            "required": ["places", "id"]
          },
          "result": {
            "type": "object",
            "properties": { "forgotten": { "type": "boolean" } },
            "required": ["forgotten"],
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
