{
  "$schema": "https://weivel.github.io/model/library.schema.json",
  "id": "runtime",
  "version": "0.1.0",
  "binary": "runtime",
  "release": "runtime_release",
  "services": [
    {
      "id": "paths",
      "functions": [
        {
          "name": "resolve",
          "symbol": "runtime_paths_resolve",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" }
            },
            "required": ["home"]
          },
          "result": {
            "type": "object",
            "properties": {
              "home": { "type": "string" },
              "repos": { "type": "string" },
              "plugin": { "type": "string" },
              "cache": { "type": "string" },
              "config": { "type": "string" }
            },
            "required": ["home", "repos", "plugin", "cache", "config"],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "config",
      "functions": [
        {
          "name": "all",
          "symbol": "runtime_config_all",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "plugin": { "type": "string" },
              "config": { "type": "object" }
            },
            "required": ["home", "plugin"]
          },
          "result": {
            "type": "object",
            "properties": { "values": { "type": "object" } },
            "required": ["values"],
            "additionalProperties": false
          }
        },
        {
          "name": "get",
          "symbol": "runtime_config_get",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "key": { "type": "string" }
            },
            "required": ["home", "plugin", "key"]
          },
          "result": {
            "type": "object",
            "properties": { "value": {} },
            "additionalProperties": false
          }
        },
        {
          "name": "set",
          "symbol": "runtime_config_set",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "key": { "type": "string" },
              "value": {}
            },
            "required": ["home", "plugin", "key", "value"]
          },
          "result": {
            "type": "object",
            "properties": { "previous": {} },
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "log",
      "functions": [
        {
          "name": "write",
          "symbol": "runtime_log_write",
          "kind": "json",
          "argument": {
            "type": "object",
            "properties": {
              "home": { "type": "string", "minLength": 1 },
              "names": { "type": "object" },
              "plugin": { "type": "string" },
              "config": { "type": "object" },
              "start": { "type": "string" },
              "time": { "type": "string" },
              "level": { "enum": ["debug", "info", "warn", "error"] },
              "message": { "type": "string" },
              "noColor": { "type": "boolean" }
            },
            "required": ["home", "plugin", "start", "time", "level", "message", "noColor"]
          },
          "result": {
            "type": "object",
            "properties": { "console": { "type": "string" } },
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
