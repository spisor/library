execute_process(COMMAND ${CMAKE_COMMAND} -S ${SOURCE} -B ${BINARY} -G ${GENERATOR} -DCMAKE_BUILD_TYPE=Release
                        -DSPIKE_NESTED_RELEASE=ON
                RESULT_VARIABLE configured)
if(NOT configured EQUAL 0)
    message(FATAL_ERROR "the Release tree did not configure")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} --build ${BINARY} --config Release --target ${TARGET} RESULT_VARIABLE built)
if(NOT built EQUAL 0)
    message(FATAL_ERROR "the Release benchmark did not build")
endif()
file(GLOB_RECURSE candidates ${BINARY}/${TARGET} ${BINARY}/${TARGET}.exe)
list(FILTER candidates EXCLUDE REGEX "CMakeFiles")
list(LENGTH candidates found)
if(NOT found EQUAL 1)
    message(FATAL_ERROR "expected one Release ${TARGET} under ${BINARY}, found: ${candidates}")
endif()
execute_process(COMMAND ${candidates} measure RESULT_VARIABLE ran)
if(NOT ran EQUAL 0)
    message(FATAL_ERROR "the Release benchmark failed")
endif()
